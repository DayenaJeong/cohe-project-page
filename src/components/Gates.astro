---
import { results, number } from '../data/results';
import EffectPlot from './EffectPlot.astro';
const gates=[
 {name:'Dependence',question:'Does the proxy relate to the target?',evidence:'Compare sample-indexed proxy and target scores using Pearson r, Spearman ρ, and density diagnostics; optionally test nonlinear dependence.',support:'Supports rank alignment with the chosen target.',boundary:'An association does not establish how well the proxy predicts unseen target values.',label:'Observe the relationship',diagram:['Proxy scores','Matched sample IDs','Target scores'],example:`DINOv2 isolation and first-learning: Spearman ρ = ${number(results.firstLearning.rho,4)}.`},
 {name:'Predictive Validity',question:'Can it predict held-out target variation?',evidence:'Fit a predictor using the declared scalar or low-dimensional proxy inputs. Report held-out R², split variability, confidence intervals, and matched null baselines.',support:'Adds predictive validity for the stated target.',boundary:'Predicting first-learning does not establish a benefit from selecting isolated samples for training.',label:'Test on held-out samples',diagram:['Declared proxy inputs','Fit on training split','Evaluate held-out target'],example:`DINOv2 isolation predicts first-learning with held-out R² = ${number(results.firstLearning.r2,4)}.`},
 {name:'Operational Transfer',question:'Does using the proxy actually help?',evidence:'Run the declared selection, ordering, or retrieval protocol against a relevant matched baseline. Report seed-paired metric differences and uncertainty.',support:'Supports actionability within the evaluated protocol when the declared evidence requirements are met.',boundary:'A policy benefit alone does not prove scalar-surrogate validity. A failed policy does not erase relational evidence.',label:'Evaluate the declared use',diagram:['Proxy-based policy','Seed-matched baseline','Downstream endpoint'],example:'DINOv2 hard-only selection at 10%: a negative paired effect against Random, despite its first-learning signal.'}
];
---
<section id="framework" class="framework section-dark" aria-labelledby="framework-title"><div class="container">
  <div class="section-heading"><span class="section-number">02 / The framework</span><h2 id="framework-title">Three questions.<br/><em>Three kinds of evidence.</em></h2><p>Cross-Objective Hardness Evaluation keeps each claim tied to its proxy, target, and protocol.</p></div>
  <div class="gate-tabs" role="tablist" aria-label="COHE evidence gates">{gates.map((gate,i)=><button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span class="gate-index">0{i+1}</span><span><small>Gate {i+1}</small>{gate.name}</span></button>)}</div>
  {gates.map((gate,i)=><div class="gate-panel" id={`panel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} tabindex="0"><div class="gate-copy"><span class="overline">The question</span><h3>{gate.question}</h3><p>{gate.evidence}</p><div class="claim"><span class="overline">What this supports</span><p>{gate.support}</p></div><p class="boundary">{gate.boundary}</p></div><div class="gate-visual"><span class="overline">{gate.label}</span><ol class={`evidence-diagram diagram-${i}`}>{gate.diagram.map((text,j)=><li><span class="diagram-step">{j+1}</span>{text}</li>)}</ol><div class="evidence-example"><span class="overline">Evidence from the paper</span>{i===2?<EffectPlot rows={[results.dino[0]]} min={-20} max={0} ticks={[-20,-10,0]} label="DINOv2 10% hard-selection effect"/>:<div class="evidence-stat"><strong>{i===0?'ρ':'R²'} <span>{number(i===0?results.firstLearning.rho:results.firstLearning.r2,4)}</span></strong><span>DINOv2 isolation · first-learning</span></div>}<p>{gate.example}</p></div></div></div>)}
  <p class="gate-footnote">The diagrams show the evaluation process; they are conceptual illustrations. The numerical examples are measured paper results. Thresholds and claim tiers follow the full audit specification, with no universal pass/fail score.</p>
</div></section>
<script>
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
const panels=Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
function activate(index:number,focus=false){tabs.forEach((t,i)=>{t.setAttribute('aria-selected',String(i===index));t.tabIndex=i===index?0:-1;});panels.forEach((p,i)=>{p.hidden=i!==index;});if(focus)tabs[index].focus();}
tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(i));tab.addEventListener('keydown',event=>{let next=i;if(event.key==='ArrowRight')next=(i+1)%tabs.length;else if(event.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();activate(next,true);});});activate(0);
</script>
