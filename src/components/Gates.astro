---
import { results, number } from '../data/results';
import EffectPlot from './EffectPlot.astro';
const gates = [
  {
    name: 'Dependence',
    question: 'Does the proxy relate to the target?',
    evidence:
      'Compare sample-indexed proxy and target scores using Pearson r, Spearman ρ, and density diagnostics; optionally test nonlinear dependence.',
    support: 'Supports rank alignment with the chosen target.',
    boundary:
      'An association does not establish how well the proxy predicts unseen target values.',
    label: 'Observe the relationship',
    diagram: ['Proxy scores', 'Matched sample IDs', 'Target scores'],
    example: `DINOv2 isolation and first-learning: Spearman ρ = ${number(results.firstLearning.rho, 4)}.`,
  },
  {
    name: 'Predictive Validity',
    question: 'Can it predict held-out target variation?',
    evidence:
      'Fit a predictor using the declared scalar or low-dimensional proxy inputs. Report held-out R², split variability, confidence intervals, and matched null baselines.',
    support: 'Adds predictive validity for the stated target.',
    boundary:
      'Predicting first-learning does not establish a benefit from selecting isolated samples for training.',
    label: 'Test on held-out samples',
    diagram: ['Declared proxy inputs', 'Fit on training split', 'Evaluate held-out target'],
    example: `DINOv2 isolation predicts first-learning with held-out R² = ${number(results.firstLearning.r2, 4)}.`,
  },
  {
    name: 'Operational Transfer',
    question: 'Does using the proxy actually help?',
    evidence:
      'Evaluate the declared downstream endpoint against a matched baseline. Retraining uses seed-paired accuracy differences; retrieval uses target-hard recall and a shuffled-ranking null.',
    support:
      'Supports actionability within the evaluated protocol when the declared evidence requirements are met.',
    boundary:
      'A policy benefit alone does not prove scalar-surrogate validity. A failed policy does not erase relational evidence.',
    label: 'Evaluate the declared use',
    diagram: ['Proxy-based policy', 'Seed-matched baseline', 'Downstream endpoint'],
    example:
      'DINOv2 hard-only selection at 10%: a negative paired effect against Random, despite its first-learning signal.',
  },
];
---

<section id="framework" class="section framework" aria-labelledby="framework-title">
  <h2 id="framework-title">COHE Framework</h2>
  <p>
    Cross-Objective Hardness Evaluation keeps each claim tied to its proxy, target, and
    protocol.
  </p>
  <div class="gate-tabs" role="tablist" aria-label="COHE evidence gates">
    {gates.map((gate, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${i}`}
        aria-controls={`panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        <span class="gate-label">Gate {i + 1}</span>
        <strong>{gate.name}</strong>
        <span class="gate-question">{gate.question}</span>
      </button>
    ))}
  </div>
  {gates.map((gate, i) => (
    <div
      class="gate-panel"
      id={`panel-${i}`}
      role="tabpanel"
      aria-labelledby={`tab-${i}`}
      tabindex="0"
    >
      <div class="gate-copy">
        <h3>{gate.question}</h3>
        <p>{gate.evidence}</p>
        <p class="claim">
          {gate.support}
        </p>
        <p class="boundary">
          {gate.boundary}
        </p>
      </div>
      <div class="gate-visual">
        <p class="detail-label">{gate.label}</p>
        <ol class="evidence-diagram">
          {gate.diagram.map((text) => (
            <li>{text}</li>
          ))}
        </ol>
        <div class="evidence-example">
          {i === 2 ? (
            <EffectPlot
              rows={[results.dino[0]]}
              min={-20}
              max={0}
              ticks={[-20, -10, 0]}
              label="DINOv2 10% hard-selection effect"
            />
          ) : (
            <p class="evidence-stat">
              <strong>
                {i === 0 ? 'ρ' : 'R²'} ={' '}
                {number(i === 0 ? results.firstLearning.rho : results.firstLearning.r2, 4)}
              </strong>
              <span>DINOv2 isolation · first-learning</span>
            </p>
          )}
          {i === 2 && <p>{gate.example}</p>}
        </div>
      </div>
    </div>
  ))}
  <p class="gate-footnote">
    Gate 1 and 2 examples use first-learning; Gate 3 measures test accuracy after subset
    retraining. Each result retains its target and protocol.
  </p>

  <figure class="paper-figure protocol-figure">
    <a
      href={`${import.meta.env.BASE_URL}figures/cohe-protocol.svg`}
      aria-label="Open the original COHE protocol figure at full resolution"
    >
      <img
        src={`${import.meta.env.BASE_URL}figures/cohe-protocol.svg`}
        alt="Original paper Figure 1: an audit tuple proceeds through dependence, held-out prediction, and operational transfer to a bounded claim tier."
        loading="lazy"
        width="905.54"
        height="133.55"
      />
    </a>
    <figcaption>
      Each gate licenses its own evidence level; the audit retains the scope of the final claim.{' '}
      <span class="figure-mobile-note">
        Scroll the figure to read its labels, or tap to open the full vector.
      </span>
    </figcaption>
  </figure>
  <div class="protocol-notes">
    <p>
      Declare the proxy and score direction, target, learner, splits, baselines, and downstream
      use before interpreting the evidence.
    </p>
    <p>
      Declare thresholds and safety margins using matched null behavior and variability. COHE
      uses setting-specific evidence requirements, not universal cutoffs.
    </p>
  </div>
</section>
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
  function activate(index: number, focus = false) {
    tabs.forEach((t, i) => {
      t.setAttribute('aria-selected', String(i === index));
      t.tabIndex = i === index ? 0 : -1;
    });
    panels.forEach((p, i) => {
      p.hidden = i !== index;
    });
    if (focus) tabs[index].focus();
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(i));
    tab.addEventListener('keydown', (event) => {
      let next = i;
      if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (i + tabs.length - 1) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault();
      activate(next, true);
    });
  });
  activate(0);
</script>
